  <Source dwd:design-time-name="f59d4a89-9924-43a5-aef4-7f52171404b6">
    <DataSourceViewID>BikeZ DW</DataSourceViewID>
  </Source>
  <MdxScripts>
    <MdxScript dwd:design-time-name="c133edac-39f7-478c-837d-5b954e1fc3f0">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T03:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T03:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>/*
El comando CALCULATE controla la agregación de celdas hoja en el cubo.
Si se elimina o modifica el comando CALCULATE, se ven afectados los datos del cubo.
Solo debe editar este comando si especifica manualmente cómo se agrega el cubo.
*/
CALCULATE;  

CREATE MEMBER CURRENTCUBE.[Measures].[Ticket Promedio]
 AS IIF([Measures].[Cantidad de ventas] = 0, NULL, [Measures].[Venta Total] / [Measures].[Cantidad de ventas]), 
FORMAT_STRING = '#,##0.00', 
VISIBLE = 1;  

CREATE MEMBER CURRENTCUBE.[Measures].[Precio Promedio]
 AS IIF([Measures].[Cantidad] = 0, NULL, [Measures].[Venta Total] / [Measures].[Cantidad]), 
FORMAT_STRING = '#,##0.00', 
VISIBLE = 1;  

CREATE MEMBER CURRENTCUBE.[Measures].[Dias de envio promedio]
 AS IIF([Measures].[Lineas de venta] = 0, NULL, [Measures].[Dias de envio] / [Measures].[Lineas de venta]), 
FORMAT_STRING = '0.00', 
VISIBLE = 1  ;  

CREATE MEMBER CURRENTCUBE.[Measures].[Venta Total Anio Anterior]
 AS IIF([Fecha Venta].[Calendario].CurrentMember.Level.Ordinal = 0, NULL, ([Measures].[Venta Total], ParallelPeriod([Fecha Venta].[Calendario].[Anio], 1, [Fecha Venta].[Calendario].CurrentMember))), 
FORMAT_STRING = '#,##0.00', 
VISIBLE = 1;  

CREATE MEMBER CURRENTCUBE.[Measures].[Crecimiento Anual %]
 AS IIF(IsEmpty([Measures].[Venta Total]) OR IsEmpty([Measures].[Venta Total Anio Anterior]) OR [Measures].[Venta Total Anio Anterior] = 0, NULL, ([Measures].[Venta Total] - [Measures].[Venta Total Anio Anterior]) / [Measures].[Venta Total Anio Anterior]), 
FORMAT_STRING = '0.0%', 
VISIBLE = 1  ;  

CREATE MEMBER CURRENTCUBE.[Measures].[Crecimiento Mensual %]
 AS IIF([Fecha Venta].[Calendario].CurrentMember.Level.Ordinal &lt;&gt; 3 OR IsEmpty([Measures].[Venta Total]), NULL, IIF(IsEmpty(([Measures].[Venta Total], [Fecha Venta].[Calendario].CurrentMember.PrevMember)), NULL, ([Measures].[Venta Total] - ([Measures].[Venta Total], [Fecha Venta].[Calendario].CurrentMember.PrevMember)) / ([Measures].[Venta Total], [Fecha Venta].[Calendario].CurrentMember.PrevMember))), 
FORMAT_STRING = '0.0%', 
VISIBLE = 1  ;  

CREATE MEMBER CURRENTCUBE.[Measures].[Participacion %]
 AS IIF(([Measures].[Venta Total], Root([Territorio])) = 0, NULL, [Measures].[Venta Total] / ([Measures].[Venta Total], Root([Territorio]))), 
FORMAT_STRING = '0.0%', 
VISIBLE = 1; </Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
  <Kpis>
    <Kpi dwd:design-time-name="5033a314-7dd8-4a21-b9bb-4d2384e9b805">
      <ID>KPI</ID>
      <Name>Crecimiento anual de ventas</Name>
      <AssociatedMeasureGroupID>Fact Ventas</AssociatedMeasureGroupID>
      <Value>[Measures].[Crecimiento_anual_porcentaje]</Value>
      <Goal>0  </Goal>
      <Status>IIF(IsEmpty(KpiValue("Crecimiento anual de ventas")), NULL, IIF(KpiValue("Crecimiento anual de ventas") &gt;= KpiGoal("Crecimiento anual de ventas"), 1, -1))</Status>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Traffic Light</StatusGraphic>
    </Kpi>
  </Kpis>
</Cube>